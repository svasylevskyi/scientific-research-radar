# Separate server, secrets, database volumes, hostname, backups and project name.
# This is a configuration template, NOT a production-readiness certification.
PUBLIC_HOST=radar.your-domain.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_RANDOM_HEX
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_HEX
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM=radar@your-domain.com
