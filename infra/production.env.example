# Separate server, secrets, database volumes, hostname, backups and project name.
# This is a configuration template, NOT a production-readiness certification.
PUBLIC_HOST=radar.your-domain.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_RANDOM_HEX
SUPER_ADMIN_EMAIL=admin@your-domain.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_HEX
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
EMAIL_FROM=radar@your-domain.com
# OPENAI_API_KEY=
# OPENAI_RADAR_MODEL=your-available-model

# Optional: super-admin spending page (separate billing credential, API server only).
# OPENAI_ADMIN_API_KEY=
# OPENAI_COSTS_PROJECT_ID=proj_your_project

# Set this before the first startup against a NEW production database.
STRIPE_MODE=live
STRIPE_CHECKOUT_ENABLED=false
# STRIPE_API_KEY=rk_live_your_restricted_key
# STRIPE_WEBHOOK_SECRET=whsec_your_live_endpoint_secret
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_your_live_configuration
# Follow docs/stripe-deployment.md before enabling checkout.
