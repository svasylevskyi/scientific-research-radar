# Copy to /etc/radar/development.env, owned by root, mode 600.
# Generate each password/secret separately: openssl rand -hex 32
# Use hexadecimal POSTGRES_PASSWORD so it is safe inside the database URL.
PUBLIC_HOST=replace-with-your-host.duckdns.org
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
JWT_SECRET=REPLACE_WITH_RANDOM_HEX
SUPER_ADMIN_EMAIL=replace-with-your-email@example.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_HEX
# Optional until explicitly enabling research mode. No key needed for base mode.
# OPENAI_API_KEY=
# OPENAI_RADAR_MODEL=your-available-model
# Default development run budgets; provider billing limits should also be set.
RADAR_RUNS_PER_HOUR=2
RADAR_RUNS_PER_DAY=5

# Optional: super-admin spending page (separate billing credential, API server only).
# OPENAI_ADMIN_API_KEY=
# OPENAI_COSTS_PROJECT_ID=proj_your_project

# Optional read-only Stripe sandbox catalogue verification (API service only).
# Restricted sandbox key with Products: Read and Prices: Read. Never a live key.
# STRIPE_SANDBOX_API_KEY=
