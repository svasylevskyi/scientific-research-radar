APP_NAME=Scientific Research Radar API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/research_radar.db
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=scientific-research-radar
JWT_AUDIENCE=scientific-research-radar-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=research_radar_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:5173"]
OPENAI_API_KEY=
OPENAI_RADAR_MODEL=gpt-6-astra
OPENAI_RADAR_DISCOVERY_REASONING_EFFORT=medium
OPENAI_RADAR_SUMMARY_REASONING_EFFORT=low
OPENAI_RADAR_TREND_REASONING_EFFORT=medium
OPENAI_RADAR_BRIEFING_REASONING_EFFORT=low
OPENAI_REQUEST_TIMEOUT_SECONDS=60
OPENAI_BACKGROUND_POLL_TIMEOUT_SECONDS=900
OPENAI_BACKGROUND_POLL_INTERVAL_SECONDS=2
OPENAI_RADAR_MAX_OUTPUT_TOKENS=30000
OPENAI_RADAR_MAX_SEARCH_TOOL_CALLS=8
OPENAI_RADAR_SEARCH_CONTEXT_SIZE=medium
OPENAI_RADAR_SUMMARY_BATCH_SIZE=5
RADAR_HISTORY_RUNS=3
RADAR_WORKER_POLL_INTERVAL_SECONDS=1
# Keep this at least 15 seconds longer than OPENAI_REQUEST_TIMEOUT_SECONDS.
RADAR_WORKER_LEASE_SECONDS=120
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_FULL_NAME=System Administrator
SUPER_ADMIN_PASSWORD=change-me-before-production
